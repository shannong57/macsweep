# Backups run slowly by design so they don't get in the way. Resets at restart.
tm_fast() { [ "$(sysctl -n debug.lowpri_throttle_enabled 2>/dev/null)" = 0 ]; }

flush_dns() { run sudo dscacheutil -flushcache && run sudo killall -HUP mDNSResponder; }

rebuild_open_with() {
