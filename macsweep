    -r -f -apps local,system,user
}

remove_snapshots() {
  local dates="$1" d ok=0
  for d in $dates; do run sudo tmutil deletelocalsnapshots "$d" || ok=1; done
  return "$ok"
}

task_result() { if [ "$1" = 0 ]; then echo "  Done."; else echo "  That didn't work."; fi; }

# Clears the screen when switching menus. Only on a real screen, so scripts and tests
# never see escape codes.
cls() { if [ -t 1 ]; then printf '\033[H\033[2J'; else echo; fi; }

# Shows each command before running it, so you can see what macsweep is doing.
run() { printf '  $'; printf ' %q' "$@"; echo; "$@"; }

# Shows a message and waits, so the next clear doesn't wipe it unread.
say_back() { echo "$1"; ask "Press Enter to go back: "; }

# Prompt into $reply. q quits from any menu, and so does end of input.
ask() {
  printf "%s" "$1"
  read -r reply || { echo; exit 0; }
  reply=${reply%.}   # "3." works like "3"
  case "$reply" in q|Q) exit 0 ;; esac
}

cat_label() {
  case "$1" in
    caches) echo "Caches" ;;
    logs)   echo "Logs" ;;
    trash)  echo "Trash" ;;
    xcode)  echo "Xcode" ;;
    devcaches) echo "Dev caches" ;;
    backups) echo "iPhone backups" ;;
  esac
}

# "1 3" -> those category names, one per line. Fails on anything else, and on
# an empty selection: cmd_clean treats no categories as all of them.
# The lines of LIST picked by INPUT, a set of 1-based numbers.
pick() {  # pick LIST INPUT
  local n c out=""
  for n in $(echo "$2" | tr -s " ," "\n"); do
    case "$n" in *[!0-9]*) return 1 ;; esac
    c=$(echo "$1" | sed -n "${n}p" 2>/dev/null)
    [ -n "$c" ] || return 1
    case $'\n'"$out" in *$'\n'"$c"$'\n'*) ;; *) out="$out$c"$'\n' ;; esac
  done
  [ -n "$out" ] || return 1
  printf "%s" "$out"
}

menu_clean() {
  local cat i picked all="$CATEGORIES"$'\n'"$OPTIN"
  cls
  while :; do
    echo; echo "  Clean up junk — scanning..."
    i=0
    for cat in $all; do
      i=$((i + 1))
      if category_blocked "$cat"; then
        printf "  %s. %-15s (no access, needs Full Disk Access)\n" "$i" "$(cat_label "$cat")"
      else
        printf "  %s. %-15s %8s\n" "$i" "$(cat_label "$cat")" "$(category_kb "$cat" | human)"
      fi
    done
    echo "  a  All except iPhone backups     b  Back"
    echo
    ask "Clean which? (numbers, a for all, b to go back): "
    case "$reply" in
      b|B) return ;;
      a|A) picked="$CATEGORIES" ;;
      *) picked=$(pick "$all" "$reply") || { echo "  Not a valid choice."; continue; } ;;
    esac
    # shellcheck disable=SC2086  # one category per line, split on IFS
    cmd_clean $picked
  done
}

# Asks for a folder and a minimum size into $path and $min. Fails on b or bad input.
ask_folder_min() {  # ask_folder_min DEFAULT_MB
  echo
  ask "Folder to search (Enter for your home folder, b to go back): "
  case "$reply" in b|B) return 1 ;; esac
  path="${reply:-$HOME}"
  path="${path/#\~/$HOME}"
  [ -d "$path" ] || { say_back "  Not a folder: $path"; return 1; }
  ask "Smallest size in MB (Enter for $1, b to go back): "
  case "$reply" in b|B) return 1 ;; esac
  min="${reply:-$1}"
  case "$min" in *[!0-9]*) say_back "  Size must be a whole number of MB."; return 1 ;; esac
}

menu_big() {
  local path min out
  cls
  ask_folder_min 500 || return
  echo "  Searching..."
  out=$(cmd_big "$path" --min "$min")
  echo "${out:-  Nothing that large.}"
  echo
  ask "Press Enter to go back: "
}

menu_uninstall() {
  local apps="" scan=1 i kb app
  cls
  while :; do
    if [ "$scan" = 1 ]; then echo; echo "  Measuring apps..."; apps=$(list_apps); fi
    [ -n "$apps" ] || { say_back "  No apps found."; return; }
    printf "  %3s  %-30.30s %-16.16s %8s\n" "#" "App" "Version" "Size"
    i=0
    echo "$apps" | while IFS=$'\t' read -r kb app; do
      i=$((i + 1))
      printf "  %3s. %-30.30s %-16.16s %8s\n" "$i" "$(basename "$app" .app)" \
        "$(plist_get "$app/Contents/Info.plist" CFBundleShortVersionString)" "$(echo "$kb" | human)"
    done
    echo
    ask "Uninstall which? (number, b to go back): "
    scan=0
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    app=$(echo "$apps" | sed -n "${reply}p" 2>/dev/null | cut -f2-)
    [ -n "$app" ] || { echo "  Not a valid choice."; continue; }
    uninstall_app "$app"
    scan=1
  done
}

menu_leftovers() {
  local items="" scan=1 sel
  cls
  while :; do
    if [ "$scan" = 1 ]; then echo; echo "  Looking for leftovers of removed apps..."; items=$(all_leftovers); fi
    [ -n "$items" ] || { say_back "  No leftovers of removed apps found."; return; }
    print_items "$items"
    echo
    ask "Move which to the Trash? (numbers, a for all, b to go back): "
    scan=0
    case "$reply" in
      b|B|"") return ;;
      a|A) sel=$items ;;
      *) sel=$(pick "$items" "$reply") || { echo "  Not a valid choice."; continue; } ;;
    esac
    confirm "Move $(plural "$(echo "$sel" | grep -c .)" item) to the Trash?" || continue
    trash_items "$sel"
    scan=1
  done
}

# "group<tab>bytes<tab>path" for files with identical contents, biggest files first.
# Matches are confirmed byte for byte. Hard links to one file, cloud-only files, ~/Library,
# the Trash, and the insides of apps, photo libraries and other packages are skipped.
# ponytail: within one size and checksum, only exact copies of the first file are kept.
dupe_groups() {  # dupe_groups DIR MIN_MB
  local f kb size crc prev="" first="" shown=0 id=0
  find "$1" -xdev \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name .git -o -name node_modules \
       -o -name "*.app" -o -name "*.photoslibrary" -o -name "*.photolibrary" -o -name "*.musiclibrary" \
       -o -name "*.tvlibrary" -o -name "*.imovielibrary" -o -name "*.fcpbundle" -o -name "*.logicx" \
       -o -name "*.band" -o -name "*.bundle" -o -name "*.framework" -o -name "*.sparsebundle" \) -prune \
       -o -type f -size +$(($2 * 2048)) -print 2>/dev/null \
    | while IFS= read -r f; do
        case "$f" in *$'\t'*) continue ;; esac
        kb=$(du -k "$f" 2>/dev/null | cut -f1)
        [ "${kb:-0}" -ge $(($2 * 1024)) ] || continue   # cloud-only files use no disk
        printf "%s\t%s\n" "$(wc -c < "$f" | tr -d ' ')" "$f"
      done \
    | awk -F'\t' '{ n[$1]++; r[NR] = $0; s[NR] = $1 } END { for (i = 1; i <= NR; i++) if (n[s[i]] > 1) print r[i] }' \
    | while IFS=$'\t' read -r size f; do printf "%s\t%s\t%s\n" "$size" "$(cksum < "$f" | cut -d ' ' -f 1)" "$f"; done \
    | sort -t $'\t' -k1,1nr -k2,2 -k3,3 \
    | while IFS=$'\t' read -r size crc f; do
        if [ "$size:$crc" != "$prev" ]; then prev="$size:$crc"; first="$f"; shown=0; continue; fi
        [ "$f" -ef "$first" ] && continue
        cmp -s "$first" "$f" || continue
        if [ "$shown" = 0 ]; then id=$((id + 1)); shown=1; printf "%s\t%s\t%s\n" "$id" "$size" "$first"; fi
        printf "%s\t%s\t%s\n" "$id" "$size" "$f"
      done
}

print_dupes() {  # print_dupes ROWS
  echo "$1" | awk -F'\t' '{ n[$1]++; s[$1] = $2 } END { for (g in n) printf "%s\t%s\t%s\n", g, n[g], s[g] }' | sort -n \
    | while IFS=$'\t' read -r g n size; do
        printf "  %3s. %s copies of %s, %s could be freed\n" "$g" "$n" "$(echo $((size / 1024)) | human)" "$(echo $(((n - 1) * size / 1024)) | human)"
        echo "$1" | awk -F'\t' -v g="$g" '$1 == g { print "         " $3 }'
      done
}

cmd_dupes() {
  local path="$HOME" min=10 rows
  while [ $# -gt 0 ]; do
    case "$1" in
      --min) [ $# -ge 2 ] || die "--min needs a number"; min="$2"; shift ;;
      -*) die "unknown option: $1" ;;
      *) path="$1" ;;
    esac
    shift
  done
  case "$min" in ''|*[!0-9]*) die "--min must be a whole number of MB" ;; esac
  [ -d "$path" ] || die "not a directory: $path"
  rows=$(dupe_groups "$path" "$min")
  if [ -n "$rows" ]; then print_dupes "$rows"; else echo "  No duplicate files of $min MB or more."; fi
}

menu_dupes() {
  local path min rows row g size f keep copies n p moved
  cls
  ask_folder_min 10 || return
  echo "  Comparing files. This reads every candidate in full, so it can take a while..."
  rows=$(dupe_groups "$path" "$min")
  while :; do
    rows=$(echo "$rows" | while IFS=$'\t' read -r g size f; do [ -e "$f" ] && printf "%s\t%s\t%s\n" "$g" "$size" "$f"; done \
      | awk -F'\t' '{ n[$1]++; r[NR] = $0; g[NR] = $1 } END { for (i = 1; i <= NR; i++) if (n[g[i]] > 1) print r[i] }')
    [ -n "$rows" ] || { echo "  No duplicate files of $min MB or more."; ask "Press Enter to go back: "; return; }
    echo
    print_dupes "$rows"
    echo
    echo "  Copies made with Finder's Duplicate can share disk space, so removing them may free less."
    ask "Clean up which group? (number, b to go back): "
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    copies=$(echo "$rows" | awk -F'\t' -v g="$reply" '$1 == g { print $3 }')
    [ -n "$copies" ] || { echo "  Not a valid choice."; continue; }
    echo "$copies" | awk '{ printf "  %3d. %s\n", NR, $0 }'
    ask "Keep which copy? The others go to the Trash. (number, b to go back): "
    case "$reply" in b|B|"") continue ;; *[!0-9]*) echo "  Not a valid choice."; continue ;; esac
    keep=$(echo "$copies" | sed -n "${reply}p" 2>/dev/null)
    [ -n "$keep" ] || { echo "  Not a valid choice."; continue; }
    n=$(($(echo "$copies" | wc -l) - 1))
    confirm "Keep $keep and move the other $n to the Trash?" || continue
    moved=0
    for p in $copies; do
      [ "$p" = "$keep" ] && continue
      if to_trash "$p"; then moved=$((moved + 1)); else echo "  Couldn't move $p; left in place."; fi
    done
    echo "  Moved $moved to the Trash. (Recover with Finder > Put Back)"
  done
}

