menu_cookies() {  # menu_cookies ROW-FROM-cookie_dbs
  local name label app table col db sites list picked n total i=0 c s mark
  cls
  IFS=$'\t' read -r name label app table col db <<EOF
$1
EOF
  if browser_running "$app"; then
    echo "  $app is open, and macsweep won't change cookies while it's open."
    confirm "Force quit $app? Unsaved work in it will be lost." || return
    force_quit "/$app.app" || { say_back "  Couldn't quit $app, so nothing was changed."; return; }
  fi
  if ! sql_read "$db" "SELECT $col FROM $table LIMIT 1" >/dev/null; then
    say_back "  This version of $name stores cookies in a way macsweep doesn't recognise, so nothing was changed."
    return
  fi
  while :; do
    sites=$(cookie_sites "$db" "$table" "$col")
    [ -n "$sites" ] || { say_back "  No cookies in $name ($label)."; return; }
    list=$(echo "$sites" | cut -f2)
    echo
    echo "  $name ($label): cookies by site"
    i=0
    echo "$sites" | while IFS=$'\t' read -r c s; do
      i=$((i + 1)); mark=""
      if kept_sites | grep -qxF -- "$s"; then mark="kept"; fi
      printf "  %4s. %-40.40s %5s  %s\n" "$i" "$s" "$c" "$mark"
    done
    echo
    echo "  numbers  remove those sites      a  remove all except kept"
    echo "  k 1 2    always keep sites       u 1 2  stop keeping sites      b  back"
    ask "Choose: "
    case "$reply" in
      b|B|"") return ;;
      a|A) picked="$list" ;;
      [kK]\ *|[uU]\ *)
        picked=$(pick "$list" "${reply#??}") || { echo "  Not a valid choice."; continue; }
        case "$reply" in [kK]*) keep_sites add "$picked" ;; *) keep_sites remove "$picked" ;; esac
        continue ;;
      *) picked=$(pick "$list" "$reply") || { echo "  Not a valid choice."; continue; } ;;
    esac
    picked=$(echo "$picked" | without_kept)
    [ -n "$picked" ] || { echo "  Nothing to remove: those sites are kept."; continue; }
    n=$(echo "$picked" | wc -l | tr -d ' ')
    total=$(echo "$sites" | awk -F'\t' -v p="$picked" 'BEGIN { split(p, a, "\n"); for (i in a) P[a[i]] } $2 in P { t += $1 } END { print t + 0 }')
    echo "  Remove $(plural "$total" cookie) from $(plural "$n" site):"
    echo "$picked" | head -n 10 | sed 's/^/    /'
    [ "$n" -gt 10 ] && echo "    ...and $((n - 10)) more"
    echo "  You'll be signed out of these sites. This can't be undone."
    confirm "Remove them?" || continue
    if browser_running "$app"; then echo "  $app is open now, so nothing was removed."; continue; fi
    if total=$(delete_cookies "$db" "$table" "$col" "$picked") && [ -n "$total" ]; then
      echo "  Removed $(plural "$total" cookie)."
    else
      echo "  Couldn't change the cookie file, so nothing was removed."
    fi
  done
}

menu_browser() {
  local dbs row i name label app table col db c
  cls
  while :; do
    dbs=$(cookie_dbs)
    echo
    echo "  Browser cleanup: cookies"
    if [ -z "$dbs" ]; then
      echo "  No Chrome, Edge, Brave, Arc, Vivaldi or Firefox profiles found."
    else
      i=0
      echo "$dbs" | while IFS=$'\t' read -r name label app table col db; do
        i=$((i + 1))
        c=$(sql_read "$db" "SELECT count(*) FROM $table") || c="?"
        printf "  %3s. %-8s %-30.30s %14s\n" "$i" "$name" "$label" "$(plural "$c" cookie)"
      done
    fi
    echo
    echo "  Safari: use Safari > Settings > Privacy > Manage Website Data."
    echo "  Browser caches are part of Clean up junk. Passwords, history and bookmarks are never touched."
    echo
    ask "Which profile? (number, b to go back): "
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    row=$(echo "$dbs" | sed -n "${reply}p" 2>/dev/null)
    [ -n "$row" ] || { echo "  Not a valid choice."; continue; }
    menu_cookies "$row"; cls
  done
}

menu_tweaks() {
  local i label d k t v app state n
  cls
  while :; do
    echo
    echo "  Tweaks: hidden macOS settings. Each can be put back to Apple's default here."
    i=0
    echo "$TWEAKS" | while IFS=$'\t' read -r label d k t v app; do
      i=$((i + 1)); state=off
      if tweak_on "$d" "$k" "$t" "$v"; then state=on; fi
      printf "  %s. %-4s %s\n" "$i" "$state" "$label"
    done
    n=$(echo "$TWEAKS" | wc -l | tr -d ' ')
    state=off; if tm_fast; then state=on; fi
    printf "  %s. %-4s %s\n" "$((n + 1))" "$state" "Faster Time Machine backups until restart (admin password)"
    echo "  b  Back"
    echo
    echo "  Some changes show up after you log out and back in."
    echo "  Not here on purpose: turning off Gatekeeper or System Integrity Protection. That costs"
    echo "  security and doesn't make a modern Mac faster."
    echo
    ask "Turn which on or off? (number, b to go back): "
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*|0) echo "  Not a valid choice."; continue ;;
    esac
    if [ "$reply" = "$((n + 1))" ]; then
      if tm_fast; then
        confirm "Put Time Machine back to its normal background speed?" || continue
        run sudo sysctl debug.lowpri_throttle_enabled=1; task_result $?
      else
        echo "  Backups use more disk and CPU until you restart or turn this off."
        confirm "Speed up Time Machine backups?" || continue
        run sudo sysctl debug.lowpri_throttle_enabled=0; task_result $?
      fi
      continue
    fi
    IFS=$'\t' read -r label d k t v app <<EOF
$(echo "$TWEAKS" | sed -n "${reply}p")
EOF
    [ -n "$label" ] || { echo "  Not a valid choice."; continue; }
    if tweak_on "$d" "$k" "$t" "$v"; then
      confirm "Put \"$label\" back to Apple's default?" || continue
      run defaults delete "$d" "$k"; task_result $?
    else
      confirm "Turn on \"$label\"?" || continue
      run defaults write "$d" "$k" "-$t" "$v"; task_result $?
    fi
    if [ "$app" != - ]; then run killall "$app"; fi
  done
}

menu_main() {
  local disk
  while :; do
    disk=$(df -Pk "$HOME" | awk 'NR == 2 { print $4; print $2 }' | human | paste -sd " " - | sed "s/ / free of /")
    cls
    printf "  macsweep — Mac cleanup            Disk: %s\n\n" "$disk"
    echo "  1. Clean up junk          (caches, logs, Trash, Xcode, dev caches)"
    echo "  2. Large and duplicate files"
    echo "  3. Applications           (uninstall, leftovers, updates)"
    echo "  4. Startup items"
    echo "  5. Maintenance"
    echo "  6. Security check"
    echo "  7. Browser cleanup        (cookies, site by site)"
    echo "  8. Performance check"
    echo "  9. Tweaks                 (hidden settings)"
    echo "  q  Quit"
    echo
    ask "Choose: "
    case "$reply" in
      1) menu_clean ;;
      2) menu_files ;;
      3) menu_apps ;;
      4) menu_startup ;;
      5) menu_maintenance ;;
      6) menu_security ;;
      7) menu_browser ;;
      8) cls; cmd_performance; echo; ask "Press Enter to go back: " ;;
      9) menu_tweaks ;;
      *) echo "  Not a valid choice." ;;
    esac
  done
}

[ -n "${HOME:-}" ] && [ "$HOME" != "/" ] || die "HOME is not set"
HOME_REAL=$(cd "$HOME" && pwd -P) || die "can't resolve HOME"

# Bare macsweep opens the menu at a terminal and scans when scripted.
if [ $# -eq 0 ] && [ -t 0 ]; then cmd=menu; else cmd="${1:-scan}"; fi
[ $# -gt 0 ] && shift
case "$cmd" in
  menu)    MENU=1; menu_main ;;
  scan)    cmd_scan ;;
  clean)   cmd_clean "$@" ;;
  big)     cmd_big "$@" ;;
  dupes)   cmd_dupes "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  leftovers) cmd_leftovers "$@" ;;
  updates) cmd_updates ;;
  startup) cmd_startup "$@" ;;
  security) cmd_security ;;
  performance) cmd_performance ;;
  version|--version) echo "macsweep $VERSION" ;;
  help|-h|--help)    usage ;;
  *) usage >&2; exit 1 ;;
esac
