#!/usr/bin/env bash
# macsweep — free up disk space on macOS from the command line.
# https://github.com/shannong57/macsweep  ·  MIT License
# Compatible with the stock macOS bash (3.2).
# shellcheck disable=SC2044,SC2001  # newline-only IFS and set -f make find loops safe
set -uf      # no globbing: every path below is literal
IFS=$'\n'    # split lists on newlines only, so paths may contain spaces

VERSION="0.10.0"
CATEGORIES=$'caches\nlogs\ntrash\nxcode\ndevcaches'
OPTIN=backups   # cleaned only when named: never part of "clean all"
MENU=0       # 1 when running inside the menu, which is always interactive
ROOT="${MACSWEEP_ROOT:-}"   # prefix for system folders; lets the tests use a fake one

usage() {
  cat <<EOF
macsweep $VERSION — free up disk space on macOS

Usage:
  macsweep                            Open the menu
  macsweep scan                       Show reclaimable space per category
  macsweep clean [CATEGORY...]        Delete junk (all categories if none given)
      -n, --dry-run                   Show what would be deleted, delete nothing
      -y, --yes                       Don't ask for confirmation
  macsweep big [PATH] [--min MB]      List the 20 largest files (default: ~, 500 MB)
  macsweep dupes [PATH] [--min MB]    List files with identical contents (default: ~, 10 MB)
  macsweep uninstall APP [--yes]      Remove an app and everything it left behind
  macsweep leftovers [--yes]          Move leftovers of already-removed apps to the Trash
  macsweep updates                    List outdated Homebrew, App Store and macOS items
  macsweep startup [enable|disable LABEL]  List startup items, or turn one on or off
  macsweep security                   Check security settings, app signatures and startup items
  macsweep performance                Show what's using CPU, memory and disk right now
  macsweep help | version

Categories:
  caches     ~/Library/Caches
  logs       ~/Library/Logs
  trash      ~/.Trash
  xcode      Xcode DerivedData and simulator caches
  devcaches  npm, Gradle and ~/.cache (pip, etc.)
  backups    iPhone and iPad backups. Only when named; never part of "clean all"

Cleaning only touches your own home folder and never needs sudo.
Some Maintenance tasks in the menu ask for your admin password, and so does
uninstalling an app that has system-wide files.
EOF
}

# Directories whose *contents* get cleared for a category.
targets() {
  case "$1" in
    caches)    echo "$HOME/Library/Caches" ;;
    logs)      echo "$HOME/Library/Logs" ;;
    trash)     echo "$HOME/.Trash" ;;
    xcode)     echo "$HOME/Library/Developer/Xcode/DerivedData"
               echo "$HOME/Library/Developer/CoreSimulator/Caches"
               echo "$HOME/Library/Developer/Xcode/iOS DeviceSupport"
               echo "$HOME/Library/Developer/Xcode/watchOS DeviceSupport"
               echo "$HOME/Library/Developer/Xcode/tvOS DeviceSupport"
               echo "$HOME/Library/Developer/Xcode/visionOS DeviceSupport" ;;
    backups)   echo "$HOME/Library/Application Support/MobileSync/Backup" ;;
    devcaches) echo "$HOME/.npm/_cacache"
               echo "$HOME/.gradle/caches"
               echo "$HOME/.cache" ;;
    *) return 1 ;;
  esac
}

die() { echo "macsweep: $*" >&2; exit 1; }

confirm() {
  [ -t 0 ] || [ "$MENU" = 1 ] || die "not a terminal; pass --yes to confirm"
  printf "%s [y/N] " "$1"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) return 0 ;; esac
  echo "Cancelled."
  return 1
}

# KB on stdin -> "1.2G"
human() { awk '{ split("K M G T", u); s = $1; i = 1; while (s >= 1024 && i < 4) { s /= 1024; i++ } printf "%.1f%s\n", s, u[i] }'; }

size_kb() { du -sk "$1" 2>/dev/null | awk '{ s = $1 } END { print s + 0 }'; }

# Exists but macOS privacy protection won't let us list it.
blocked() { [ -d "$1" ] && ! ls "$1" >/dev/null 2>&1; }

category_blocked() {
  local d
  for d in $(targets "$1"); do blocked "$d" && return 0; done
  return 1
}

FDA_HINT="Grant your terminal Full Disk Access (System Settings > Privacy & Security) to include it."


# Refuse anything that isn't a real directory strictly inside the real $HOME.
safe_target() {
  local d="$1" real
  [ -d "$d" ] && [ ! -L "$d" ] || return 1
  real=$(cd "$d" 2>/dev/null && pwd -P) || return 1
  case "$real" in "$HOME_REAL"/?*) return 0 ;; esac
  return 1
}

category_kb() {
  local total=0 d
  for d in $(targets "$1"); do
    safe_target "$d" && total=$((total + $(size_kb "$d")))
  done
  echo "$total"
}

cmd_scan() {
  local cat kb grand=0 any_blocked=0
  for cat in $CATEGORIES; do
    kb=$(category_kb "$cat")
    grand=$((grand + kb))
    if category_blocked "$cat"; then
      printf "  %-10s %8s  (no access)\n" "$cat" "$(echo "$kb" | human)"; any_blocked=1
    else
      printf "  %-10s %8s\n" "$cat" "$(echo "$kb" | human)"
    fi
  done
  printf "  %-10s %8s\n" "TOTAL" "$(echo "$grand" | human)"
  kb=$(category_kb backups)
  [ "$kb" -gt 0 ] && printf "  %-10s %8s  (not in TOTAL: only cleaned when named)\n" backups "$(echo "$kb" | human)"
  echo
  [ "$any_blocked" = 1 ] && echo "Some folders are protected by macOS. $FDA_HINT"
  echo "Run 'macsweep clean' to reclaim it, or 'macsweep clean --dry-run' to preview."
}

cmd_clean() {
  local dry=0 yes=0 cats="" cat d before after freed=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -y|--yes)     yes=1 ;;
      -*) die "unknown option: $1" ;;
      *) targets "$1" >/dev/null || die "unknown category: $1 (try: caches logs trash xcode devcaches backups)"
         cats="$cats$1"$'\n' ;;
    esac
    shift
  done
  [ -n "$cats" ] || cats="$CATEGORIES"

  echo "Will clear:"
  for cat in $cats; do
    for d in $(targets "$cat"); do
      if blocked "$d"; then echo "  skipped   $d (no access). $FDA_HINT"; continue; fi
      safe_target "$d" || continue
      printf "  %8s  %s\n" "$(size_kb "$d" | human)" "$d"
    done
  done
  case $'\n'"$cats" in *$'\n'backups$'\n'*)
    echo "  iPhone and iPad backups may be the only copy of a device. They are deleted, not moved to the Trash." ;;
  esac
  if [ "$dry" = 1 ]; then echo "(dry run — nothing deleted)"; return 0; fi

  if [ "$yes" != 1 ]; then
    confirm "Delete these contents?" || return 0
  fi

  for cat in $cats; do
    for d in $(targets "$cat"); do
      blocked "$d" && continue
      safe_target "$d" || continue
      before=$(size_kb "$d")
      # rm -rf removes symlinks themselves, never what they point to.
      run find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null   # hide "Operation not permitted" noise
      after=$(size_kb "$d")
      freed=$((freed + before - after))
      [ "$after" -gt 64 ] && echo "  note: some items in $d are in use or protected; left in place"
    done
  done
  echo "Freed $(echo "$freed" | human)."
}

cmd_big() {
  local path="$HOME" min=500
  while [ $# -gt 0 ]; do
    case "$1" in
      --min) [ $# -ge 2 ] || die "--min needs a number"; min="$2"; shift ;;
      -*) die "unknown option: $1" ;;
      *) path="$1" ;;
    esac
    shift
  done
  case "$min" in ''|*[!0-9]*) die "--min must be a whole number of MB" ;; esac
  [ -d "$path" ] || die "not a directory: $path"
  # Filter on disk usage too: cloud-only files (Dropbox, iCloud) report a big size but use no disk.
  find "$path" -xdev -type f -size +$((min * 2048)) -exec du -k {} + 2>/dev/null \
    | awk -F'\t' -v min="$((min * 1024))" '$1 >= min' \
    | sort -rn | head -n 20 \
    | while IFS=$'\t' read -r kb f; do printf "  %8s  %s\n" "$(echo "$kb" | human)" "$f"; done
}

plist_get() { plutil -extract "$2" raw -o - "$1" 2>/dev/null; }

# "KB<tab>path" per app, biggest first. Apple's own apps are left out, except Xcode
# and macOS installers.
list_apps() {
  local a
  for a in $(find "$ROOT/Applications" "$HOME/Applications" -maxdepth 2 -name "*.app" -prune 2>/dev/null); do
    case "$(plist_get "$a/Contents/Info.plist" CFBundleIdentifier)" in
      com.apple.dt.Xcode|com.apple.InstallAssistant.*) ;;
      com.apple.*) continue ;;
    esac
    printf "%s\t%s\n" "$(size_kb "$a")" "$a"
  done | sort -rn
}

# Folders in ~/Library and /Library whose items are named after an app's ID.
ID_DIRS=$'Application Support\nCaches\nPreferences\nPreferences/ByHost\nContainers\nGroup Containers
Application Scripts\nSaved Application State\nLogs\nHTTPStorages\nWebKit\nCookies\nLaunchAgents
Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments'
SYS_DIRS=$'LaunchAgents\nLaunchDaemons\nPrivilegedHelperTools\nApplication Support\nPreferences\nCaches\nLogs'

# IDs of other installed apps that begin with this app's ID, like Chrome Canary next to
# Chrome. without_theirs drops anything named after one of those.
longer_ids() { installed_apps | cut -f1 | ID="$1" awk '{ o = tolower($0); i = tolower(ENVIRON["ID"]) "." } index(o, i) == 1 { print o }'; }
without_theirs() {
  OTHERS="${OTHERS:-}" awk 'BEGIN { n = split(ENVIRON["OTHERS"], o, "\n") }
    { b = tolower($0); sub(/.*\//, "", b); for (i = 1; i <= n; i++) if (o[i] != "" && index(b ".", o[i] ".")) next; print }'
}

# Everything an app leaves on the Mac besides itself. Items are matched by the app's ID:
# the ID alone, or with something before or after it (a helper, a team ID, ".plist").
# By name, only an exact match, or a maker's folder that spells the name with it
# (Google/Chrome for "Google Chrome"). The ID and name come from the app itself, so
# anything that could climb out of these folders is ignored.
# ponytail: misses data in a folder named differently from the app (Code for Visual Studio Code).
app_files() {  # app_files ID NAME
  local id="$1" name="$2" L="$HOME/Library" S="$ROOT/Library" d g dirs
  case "$name" in ''|.*|*/*) ;; *)
    for d in "$L/Application Support/$name" "$L/Caches/$name" "$L/Logs/$name" "$S/Application Support/$name"; do
      if [ -e "$d" ] || [ -L "$d" ]; then echo "$d"; fi
    done
    find "$L/Application Support" "$L/Caches" "$L/Logs" -mindepth 2 -maxdepth 2 2>/dev/null |
      N="$name" awk -F/ '{ n = ENVIRON["N"]; c = $NF; p = $(NF-1) } (c == n && p != n && index(n, p) == 1) || (p " " c == n)'
    g=$(printf %s "$name" | sed 's/[][*?\\]/\\&/g')   # crash reports
    find "$L/Logs/DiagnosticReports" -maxdepth 1 \( -name "${g}-20[0-9][0-9]-*" -o -name "${g}_20[0-9][0-9]-*" \) 2>/dev/null
    find "$L/Application Support/CrashReporter" -maxdepth 1 -name "${g}_*.plist" 2>/dev/null ;;
  esac
  case "$id" in ''|.*|*[!A-Za-z0-9._-]*) return 0 ;; esac
  dirs=$(echo "$ID_DIRS" | sed "s|^|$L/|"; echo "$SYS_DIRS" | sed "s|^|$S/|")
  # The per-user cache and temp folders in /var/folders. Skipped under a test root.
  [ -n "$ROOT" ] || dirs="$dirs"$'\n'$( { getconf DARWIN_USER_CACHE_DIR; getconf DARWIN_USER_TEMP_DIR; } 2>/dev/null | sed 's|/$||')
  # shellcheck disable=SC2086  # one folder per line
  set -- $dirs -mindepth 1 -maxdepth 1 \( -iname "$id" -o -iname "$id.plist" -o -iname "$id.savedState"
  case "$id" in *.*) set -- "$@" -o -iname "$id.*" -o -iname "*.$id" -o -iname "*.$id.*" ;; esac
  find "$@" \) 2>/dev/null | without_theirs
}

# Stops an app's background jobs, so they can't restart it while it is being removed.
stop_jobs() {  # stop_jobs FILES
  local p label
  for p in $1; do
    case "$p" in */LaunchAgents/*.plist|*/LaunchDaemons/*.plist) ;; *) continue ;; esac
    label=$(plist_get "$p" Label); label="${label:-$(basename "$p" .plist)}"
    case "$label" in *[!A-Za-z0-9._-]*) continue ;; esac
    case "$p" in
      */LaunchDaemons/*) run sudo launchctl bootout "system/$label" ;;
      *) run launchctl bootout "gui/$(id -u)/$label" ;;
    esac
  done 2>/dev/null   # "not running" is the usual answer
}

# Takes the app's icon out of the Dock, which would otherwise keep it as a question mark.
dock_forget() {  # dock_forget ID
  local tmp key n hit=0
  tmp=$(mktemp) || return 0
  if defaults export com.apple.dock "$tmp" 2>/dev/null; then
    for key in persistent-apps recent-apps; do
      n=$(plist_get "$tmp" "$key")
      case "$n" in ''|*[!0-9]*) continue ;; esac
      while [ "$n" -gt 0 ]; do
        n=$((n - 1))
        if [ "$(plist_get "$tmp" "$key.$n.tile-data.bundle-identifier")" = "$1" ]; then
          plutil -remove "$key.$n" "$tmp" && hit=1
        fi
      done
    done
    if [ "$hit" = 1 ]; then run defaults import com.apple.dock "$tmp" && run killall Dock; fi
  fi
  rm -f "$tmp"
}

# Clears the installer's records of an app's packages, its saved preferences still held
# in memory, and its Dock icon.
forget_app() {  # forget_app ID
  local pkg
  case "$1" in ''|.*|*[!A-Za-z0-9._-]*) return 0 ;; esac
  for pkg in $(pkgutil --pkgs 2>/dev/null | ID="$1" awk '{ l = tolower($0); i = tolower(ENVIRON["ID"]) } l == i || index(l, i ".") == 1' | without_theirs); do
    run sudo pkgutil --forget "$pkg"
  done
  killall cfprefsd 2>/dev/null
  dock_forget "$1"
}

# /usr/bin/trash arrived in macOS 15 and refuses root-owned apps, such as Xcode
# from the App Store. Finder covers both and can ask for an admin password.
to_trash() {
  if [ -x "$ROOT/usr/bin/trash" ]; then run "$ROOT/usr/bin/trash" -s "$1"; fi
  if [ -e "$1" ] || [ -L "$1" ]; then
    echo "  (asking Finder to move it to the Trash)"
    run osascript - "$1" <<'EOF'
on run argv
  tell application "Finder" to delete (POSIX file (item 1 of argv) as alias)
end run
EOF
  fi
  [ ! -e "$1" ] && [ ! -L "$1" ]
}

# PIDs of the processes running from inside an app bundle (a path, or "/Name.app").
# Matched in the shell: a grep or awk here would see its own command line and always hit.
app_pids() {
  local pid cmd
  while IFS=" " read -r pid cmd; do
    case "$cmd" in *"$1/Contents/"*) echo "$pid" ;; esac
  done <<EOF
$(ps -axo pid=,command=)
EOF
}

# Same as Force Quit in macOS: the app gets no chance to save.
force_quit() {
  local pids
  pids=$(app_pids "$1")
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086  # one PID per word
  run kill -9 $pids || return 1
  sleep 1
}

uninstall_app() {
  local app="$1" yes="${2:-0}" plist="$1/Contents/Info.plist" name id ver all items sys p kb running
  name=$(basename "$app" .app)
  id=$(plist_get "$plist" CFBundleIdentifier)
  ver=$(plist_get "$plist" CFBundleShortVersionString)
  echo "Looking for everything $name left behind..."
  OTHERS=$(longer_ids "$id")
  all=$(app_files "$id" "$name" | sort -u)
  sys=$(echo "$all" | P="$ROOT/Library/" awk 'index($0, ENVIRON["P"]) == 1')
  items=$(echo "$all" | P="$ROOT/Library/" awk 'index($0, ENVIRON["P"]) != 1')

  echo "$name $ver — will move to Trash:"
  for p in "$app" $items; do printf "  %8s  %s\n" "$(size_kb "$p" | human)" "$p"; done
  if [ -n "$sys" ]; then
    echo "System-wide files — deleted for good, not moved to the Trash (asks for your admin password):"
    for p in $sys; do printf "  %8s  %s\n" "$(size_kb "$p" | human)" "$p"; done
  fi
  echo "Its privacy permissions, installer records and Dock icon are cleared too."
  if [ "$id" = com.apple.dt.Xcode ] && [ -d "$HOME/Library/Developer" ]; then
    echo "Stays in place: $HOME/Library/Developer ($(size_kb "$HOME/Library/Developer" | human))."
    echo "  It holds simulators and archived builds. For the part Xcode can rebuild: macsweep clean xcode"
  fi
  running=$(app_pids "$app")
  if [ -n "$running" ]; then
    if [ "$yes" = 1 ]; then echo "  $name is running. Quit it, then try again, or leave out --yes to force quit it."; return 1; fi
    confirm "$name is running. Force quit it and continue? Unsaved work in $name will be lost." || return 0
  elif [ "$yes" != 1 ]; then
    confirm "Proceed?" || return 0
  fi
  stop_jobs "$all"
  if [ -n "$running" ]; then
    force_quit "$app" || { echo "  Couldn't quit $name, so nothing was removed."; return 1; }
  fi

  kb=$(size_kb "$app")
  # Before the app goes: macOS can't look up the permissions of an app it no longer knows.
  case "$id" in ''|.*|*[!A-Za-z0-9._-]*) ;; *) run tccutil reset All "$id" 2>/dev/null ;; esac   # complains about an app that never asked for any
  if ! to_trash "$app"; then
    echo "  Couldn't move $app to the Trash, so its files were left in place. It may need admin rights: try dragging it to the Trash in Finder."
    return 1
  fi
  trash_items "$items" "$kb"
  if [ -n "$sys" ]; then
    # shellcheck disable=SC2086  # one path per line
    run sudo rm -rf -- $sys || echo "  Couldn't delete the system-wide files. They are still in place."
  fi
  forget_app "$id"
  echo "Empty the Trash to finish removing $name."
}

# Moves each path to the Trash and reports the total. START_KB counts what was already moved.
trash_items() {  # trash_items PATHS [START_KB]
  local p kb moved="${2:-0}" failed=0
  for p in $1; do
    kb=$(size_kb "$p")
    if to_trash "$p"; then moved=$((moved + kb)); else echo "  Couldn't move $p; left in place."; failed=1; fi
  done
  echo "Moved $(echo "$moved" | human) to Trash. (Recover with Finder > Put Back)"
  if [ "$failed" = 1 ]; then
    echo "If macOS said \"Operation not permitted\", give your terminal app Full Disk Access"
    echo "in System Settings > Privacy & Security, quit and reopen it, then try again."
  fi
}

# "ID<tab>name" of every installed app. Spotlight finds apps anywhere; the folder scan
# covers a Mac with Spotlight turned off.
installed_apps() {
  local a
  { mdfind 'kMDItemContentType == "com.apple.application-bundle"' 2>/dev/null
    find "$ROOT/Applications" "$HOME/Applications" "$ROOT/System/Applications" -maxdepth 3 -name "*.app" -prune 2>/dev/null
  } | while read -r a; do
    printf "%s\t%s\n" "$(plist_get "$a/Contents/Info.plist" CFBundleIdentifier)" "$(basename "$a" .app)"
  done | sort -u
}

# ~/Library items named after an app ID whose maker has no app installed. Matching the maker,
# not the whole ID, keeps the files of an installed app's helpers and extensions. Apple's,
# shared-group and printer items are never listed, nor a launch agent whose program still exists.
# A folder named only by an app's name counts when it matches the name part of such an ID
# (CleanMyMac_5_HealthMonitor for com.macpaw.CleanMyMac5.HealthMonitor), never an installed app's name.
# ponytail: misses leftovers from a maker that still has another app installed.
orphans() {
  local L="$HOME/Library" f prog
  find "$L/Application Support" "$L/Caches" "$L/Containers" "$L/Saved Application State" "$L/Logs" \
       "$L/HTTPStorages" "$L/WebKit" "$L/Preferences" "$L/LaunchAgents" -mindepth 1 -maxdepth 1 2>/dev/null |
  APPS=$(installed_apps) awk -F'\t' '
    function norm(s) { s = tolower(s); gsub(/[^a-z0-9]/, "", s); return s }
    function base(s) { sub(/.*\//, "", s); return s }
    BEGIN { n = split(ENVIRON["APPS"], a, "\n")
            for (i = 1; i <= n; i++) { split(a[i], f, "\t"); split(tolower(f[1]), p, ".")
                                       if (p[2] != "") M[p[1] "." p[2]]; N[norm(f[2])] } }
    { path[NR] = $0; id = base($0)
      sub(/^[0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z]\./, "", id)  # team ID
      id = tolower(id); sub(/\.(savedstate|plist|binarycookies)$/, "", id)
      if (id !~ /^[a-z0-9-]+\.[a-z0-9-]+\.[a-z0-9._-]+$/) { plain[NR] = 1; next }
      if (id ~ /^(com\.apple|group|systemgroup|org\.cups)\./) next
      k = split(id, p, "."); if ((p[1] "." p[2]) in M) next
      gone[NR] = 1; t = ""; for (j = 3; j <= k; j++) { t = t p[j]; T[norm(t)] } }
    END { for (i = 1; i <= NR; i++) {
            if (i in gone) print path[i]
            else if ((i in plain) && path[i] ~ /\/Library\/(Application Support|Caches|Logs)\/[^\/]*$/) {
              k = norm(base(path[i])); if (length(k) >= 4 && (k in T) && !(k in N)) print path[i] } } }' | sort |
  while read -r f; do
    case "$f" in "$L/LaunchAgents/"*)
      prog=$(plist_get "$f" ProgramArguments.0 || plist_get "$f" Program)
      if [ -n "$prog" ] && [ -e "$prog" ]; then continue; fi ;;
    esac
    echo "$f"
  done
}

# Folders in Applications that no longer hold an app: a maker's folder whose apps are gone, or
# an app an interrupted uninstall left half removed. iPhone apps keep Info.plist deeper inside;
# Chrome and Edge recreate their empty "* Apps.localized" folders.
dead_app_folders() {
  local d
  for d in $(find "$ROOT/Applications" "$HOME/Applications" -mindepth 1 -maxdepth 1 -type d ! -name "*.app" ! -name "*.localized" 2>/dev/null); do
    [ -n "$(find "$d" \( -name "*.app" -o -type l \) -print -quit 2>/dev/null)" ] || echo "$d"
  done
  for d in $(find "$ROOT/Applications" "$HOME/Applications" -maxdepth 2 -type d -name "*.app" -prune 2>/dev/null); do
    [ -n "$(find "$d" -maxdepth 3 -name Info.plist -print -quit 2>/dev/null)" ] || echo "$d"
  done
}

all_leftovers() { dead_app_folders; orphans; }

print_items() {
  local i=0 p
  for p in $1; do i=$((i + 1)); printf "  %3s. %8s  %s\n" "$i" "$(size_kb "$p" | human)" "$p"; done
}

cmd_leftovers() {
  local yes=0 items
  case "${1:-}" in -y|--yes) yes=1 ;; "") ;; *) die "unknown option: $1" ;; esac
  items=$(all_leftovers)
  [ -n "$items" ] || { echo "No leftovers of removed apps found."; return 0; }
  echo "Leftovers of apps that are no longer installed:"
  print_items "$items"
  [ "$yes" = 1 ] || confirm "Move all of these to the Trash?" || return 0
  trash_items "$items"
}

cmd_uninstall() {
  local yes=0 name="" app
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      -*) die "unknown option: $1" ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "which app? Try: macsweep uninstall Slack"
  app=$(list_apps | awk -F'\t' -v n="/$name.app" '{
    p = tolower($2); s = tolower(n)
    if (substr(p, length(p) - length(s) + 1) == s) { print $2; exit }
  }')
  [ -n "$app" ] || die "no app named $name (of Apple's own apps, only Xcode and macOS installers can be removed)"
  uninstall_app "$app" "$yes"
}

cmd_updates() {
  local out
  echo "Homebrew:"
  if command -v brew >/dev/null; then
    out=$(brew outdated 2>/dev/null)
    if [ -n "$out" ]; then echo "$out" | sed 's/^/  /'; echo "  Update with: brew upgrade"; else echo "  Up to date."; fi
  else
    echo "  Not installed."
  fi
  echo "App Store:"
  if command -v mas >/dev/null; then
    out=$(mas outdated 2>/dev/null)
    if [ -n "$out" ]; then echo "$out" | sed 's/^/  /'; echo "  Update with: mas upgrade"; else echo "  Up to date."; fi
  else
    echo "  Skipped: needs the free mas tool (brew install mas)."
  fi
  echo "macOS:"
  out=$(softwareupdate -l 2>/dev/null | sed -n 's/^\* Label: //p')
  if [ -n "$out" ]; then
    echo "$out" | sed 's/^/  /'; echo "  Update in System Settings > General > Software Update."
  else
    echo "  Up to date."
  fi
  echo
  echo "Apps that update themselves, like Chrome or Zoom, aren't covered."
}

# Who signed a program. A leading ! marks one that deserves a look.
# ponytail: a script run through /bin/sh shows Apple as signer; read the arguments if that matters.
signer() {
  local p="$1" who
  [ -n "$p" ] || { echo "unknown program"; return; }
  case "$p" in /*) ;; *) p=$(command -v "$p") ;; esac
  [ -e "$p" ] || { echo "! program missing"; return; }
  who=$(codesign -dv --verbose=2 "$p" 2>&1 | sed -n 's/^Authority=//p' | head -n 1)
  [ -n "$who" ] || { echo "! not signed"; return; }
  codesign -v "$p" 2>/dev/null || { echo "! signature invalid"; return; }
  echo "$who" | sed 's/^Developer ID Application: //; s/ ([A-Z0-9]*)$//'
}

# "kind<tab>on|off<tab>label<tab>signer<tab>plist" per launch agent and daemon.
list_startup() {
  local dir kind plist label prog state off_gui off_sys off
  off_gui=$(launchctl print-disabled "gui/$(id -u)" 2>/dev/null | awk -F'"' '/=> (disabled|true)/ { print $2 }')
  off_sys=$(launchctl print-disabled system 2>/dev/null | awk -F'"' '/=> (disabled|true)/ { print $2 }')
  for dir in "$HOME/Library/LaunchAgents" "$ROOT/Library/LaunchAgents" "$ROOT/Library/LaunchDaemons"; do
    case "$dir" in *Daemons) kind=daemon; off="$off_sys" ;; *) kind=agent; off="$off_gui" ;; esac
    for plist in $(find "$dir" -maxdepth 1 -name "*.plist" 2>/dev/null | sort); do
      label=$(plist_get "$plist" Label); label="${label:-$(basename "$plist" .plist)}"
      prog=$(plist_get "$plist" Program || plist_get "$plist" ProgramArguments.0)
      state=on
      if echo "$off" | grep -qxF -- "$label"; then state=off; fi
      printf "%s\t%s\t%s\t%s\t%s\n" "$kind" "$state" "$label" "$(signer "$prog")" "$plist"
    done
  done
}

print_startup() {
  local i=0 kind state label who plist
  printf "  %3s  %-4s %-50s %s\n" "#" "" "Item" "Signed by"
  echo "$1" | while IFS=$'\t' read -r kind state label who plist; do
    i=$((i + 1))
    printf "  %3s. %-4s %-50.50s %s\n" "$i" "$state" "$label" "$who"
  done
  echo
  echo "  ! means worth a look: the program is unsigned, damaged or gone."
  # ponytail: login items aren't listed; asking System Events for them takes about 100 seconds.
  echo "  Login items are in System Settings > General > Login Items."
}

# Turn one item on or off. Daemons belong to the whole Mac, so those only get the command.
startup_set() {
  local want="$1" kind="$2" label="$3" plist="$4" verb=disable domain
  [ "$want" = on ] && verb=enable
  case "$label" in *[!A-Za-z0-9._-]*)
    echo "  This item has an unusual name, so macsweep won't touch it. Check it by hand: $plist"
    return 1 ;;
  esac
  if [ "$kind" = daemon ]; then
    echo "  This runs for the whole Mac. To change it yourself:"
    echo "  sudo launchctl $verb system/$label"
    return 0
  fi
  domain="gui/$(id -u)"
  run launchctl "$verb" "$domain/$label" || { echo "  Couldn't change $label."; return 1; }
  if [ "$want" = on ]; then
    run launchctl bootstrap "$domain" "$plist"
  else
    run launchctl bootout "$domain/$label"
  fi
  echo "  $label is now $want."
}

cmd_startup() {
  local rows row kind state label who plist want
  case "${1:-}" in
    "") rows=$(list_startup); print_startup "$rows"; return ;;
    enable) want=on ;;
    disable) want=off ;;
    *) die "unknown startup action: $1 (try: enable, disable)" ;;
  esac
  [ $# -ge 2 ] || die "which item? Run 'macsweep startup' to list them"
  row=$(list_startup | awk -F'\t' -v l="$2" '$3 == l { print; exit }')
  [ -n "$row" ] || die "no startup item named $2"
  IFS=$'\t' read -r kind state label who plist <<EOF
$row
EOF
  startup_set "$want" "$kind" "$label" "$plist"
}

# One line per setting: ok, ! for something to fix, ? if macOS wouldn't say.
setting() {  # setting NAME OUTPUT TEXT-WHEN-ON HOW-TO-FIX
  case "$2" in
    "") printf "  ?   %s: couldn't check\n" "$1" ;;
    *"$3"*) printf "  ok  %s is on\n" "$1" ;;
    *) printf "  !   %s is off. %s\n" "$1" "$4" ;;
  esac
}

flagged_startup() { list_startup | awk -F'\t' 'index($4, "!") == 1'; }

# Apple's apps are left out by list_apps. Xcode is checked with the rest.
flagged_apps() {
  local kb a who
  list_apps | while IFS=$'\t' read -r kb a; do
    who=$(signer "$a")
    case "$who" in !*) printf "  %-20s %s\n" "$who" "$a" ;; esac
  done
}

# $1 is the rows from flagged_startup, numbered so the menu can act on them.
print_security() {
  local apps profiles i=0 kind state label who plist
  echo "  Mac settings"
  setting "Gatekeeper" "$(spctl --status 2>/dev/null)" "assessments enabled" "Turn it on in System Settings > Privacy & Security."
  setting "System Integrity Protection" "$(csrutil status 2>/dev/null)" "status: enabled" "Turning it back on needs Recovery mode: csrutil enable"
  setting "FileVault" "$(fdesetup status 2>/dev/null)" "FileVault is On" "Turn it on in System Settings > Privacy & Security."
  setting "Firewall" "$("$ROOT/usr/libexec/ApplicationFirewall/socketfilterfw" --getglobalstate 2>/dev/null)" "is enabled" "Turn it on in System Settings > Network > Firewall."
  echo
  echo "  Configuration profiles (your account only)"
  profiles=$(profiles list 2>/dev/null)
  case "$profiles" in
    "") echo "  ?   Couldn't check." ;;
    *"no configuration profiles"*) echo "  ok  None installed." ;;
    *) echo "  !   Profiles are installed. Normal on a work Mac; otherwise check System Settings > General > Device Management." ;;
  esac
  echo
  echo "  Apps"
  apps=$(flagged_apps)
  if [ -n "$apps" ]; then echo "$apps"; else echo "  ok  All signed."; fi
  echo
  echo "  Startup items"
  if [ -z "$1" ]; then
    echo "  ok  Nothing flagged."
  else
    echo "$1" | while IFS=$'\t' read -r kind state label who plist; do
      i=$((i + 1))
      printf "  %3s. %-20s %s\n" "$i" "$who" "$label"
    done
  fi
  echo
  echo "  ! means worth a look, not that it's harmful. Plenty of good apps are unsigned or fail this check."
  echo "  This is not a malware scan: it checks settings and signatures only. macOS runs its own"
  echo "  malware protection. If you're worried, use a dedicated scanner such as Malwarebytes."
}

cmd_security() {
  echo "  Checking..."
  print_security "$(flagged_startup)"
}

# Stops an item starting and bins its plist. The program it ran is left for the user to judge.
remove_startup_item() {
  local kind="$1" label="$2" plist="$3" prog
  prog=$(plist_get "$plist" Program || plist_get "$plist" ProgramArguments.0)
  startup_set off "$kind" "$label" "$plist" || return 1
  case "$plist" in
    "$HOME"/*)
      if ! to_trash "$plist"; then echo "  Couldn't move $plist to the Trash."; return 1; fi
      echo "  Moved $plist to the Trash. (Recover with Finder > Put Back)" ;;
    *) echo "  To remove the file too:"; printf "  sudo rm %q\n" "$plist" ;;
  esac
  if [ -e "$prog" ]; then echo "  The program it ran is still at $prog. Check it before deleting it."; fi
}

# Chromium browsers: name, folder in ~/Library/Application Support, app name.
BROWSERS=$'Chrome\tGoogle/Chrome\tGoogle Chrome
Edge\tMicrosoft Edge\tMicrosoft Edge
Brave\tBraveSoftware/Brave-Browser\tBrave Browser
Arc\tArc/User Data\tArc
Vivaldi\tVivaldi\tVivaldi'
KEEP_FILE="$HOME/Library/Application Support/macsweep/keep-sites"

# "browser<tab>profile<tab>app<tab>table<tab>column<tab>file" per cookie database.
cookie_dbs() {
  local AS="$HOME/Library/Application Support" name dir app db p label
  echo "$BROWSERS" | while IFS=$'\t' read -r name dir app; do
    for db in $(find "$AS/$dir" -maxdepth 3 -type f -name Cookies 2>/dev/null | sort); do
      p=${db#"$AS/$dir/"}; p=${p%%/*}
      label=$(plist_get "$AS/$dir/Local State" "profile.info_cache.$p.name")
      printf "%s\t%s\t%s\tcookies\thost_key\t%s\n" "$name" "${label:-$p}" "$app" "$db"
    done
  done
  for db in $(find "$AS/Firefox/Profiles" -maxdepth 2 -type f -name cookies.sqlite 2>/dev/null | sort); do
    p=$(basename "$(dirname "$db")")
    printf "Firefox\t%s\tFirefox\tmoz_cookies\thost\t%s\n" "${p#*.}" "$db"
  done
}

# Read-only and immutable, so it works while the browser holds its lock.
sql_read() {
  sqlite3 -readonly "file:$(printf %s "$1" | sed 's/%/%25/g; s/?/%3f/g; s/#/%23/g')?immutable=1" "$2" 2>/dev/null
}

# "count<tab>site" per site, most cookies first. A site is the last two parts of
# the host, or three for names like example.co.uk.
# ponytail: no public suffix list, so a few country domains group too broadly or narrowly.
cookie_sites() {  # cookie_sites FILE TABLE COLUMN
  sql_read "$1" "SELECT $3 FROM $2" | awk -F. '
    { sub(/^\./, ""); n = NF; if ($0 == "") next
      if (n >= 3 && length($n) == 2 && $(n-1) ~ /^(co|com|net|org|gov|ac|edu)$/) s = $(n-2) "." $(n-1) "." $n
      else if (n >= 2) s = $(n-1) "." $n
      else s = $0
      c[s]++ }
    END { for (s in c) printf "%d\t%s\n", c[s], s }' | sort -t $'\t' -k1,1rn -k2,2
}

# Removes every cookie for the given sites and their subdomains. Prints how many went.
delete_cookies() {  # delete_cookies FILE TABLE COLUMN SITES
  local where="" s
  for s in $4; do
    case "$s" in ''|.*|*[!A-Za-z0-9.-]*) continue ;; esac
    where="$where OR $3 = '$s' OR $3 = '.$s' OR $3 LIKE '%.$s'"
  done
  [ -n "$where" ] || { echo 0; return 0; }
  local sql="DELETE FROM $2 WHERE 0$where; SELECT changes();"
  printf '  $ sqlite3 %q "%s"\n' "$1" "$sql" >&2   # stdout is the count, so show the command on stderr
  sqlite3 "$1" "$sql"
}

kept_sites() { cat "$KEEP_FILE" 2>/dev/null || true; }
# The list goes in through the environment: macOS awk rejects a newline in a -v value.
without_kept() { K=$(kept_sites) awk 'BEGIN { n = split(ENVIRON["K"], a, "\n"); for (i = 1; i <= n; i++) K[a[i]] } !($0 in K)'; }

keep_sites() {  # keep_sites add|remove SITES
  mkdir -p "$(dirname "$KEEP_FILE")" || return 1
  if [ "$1" = add ]; then
    printf "%s\n%s\n" "$(kept_sites)" "$2" | sed '/^$/d' | sort -u > "$KEEP_FILE.new"
  else
    kept_sites | awk -v k="$2" 'BEGIN { n = split(k, a, "\n"); for (i = 1; i <= n; i++) K[a[i]] } !($0 in K)' > "$KEEP_FILE.new"
  fi
  mv "$KEEP_FILE.new" "$KEEP_FILE"
}

browser_running() { case "$(ps -axo command=)" in *"/$1.app/Contents/MacOS/"*) return 0 ;; esac; return 1; }

# "value<tab>app" for the five biggest users of CPU or memory. Helper processes
# count toward the app they live in, so Chrome is one line, not twenty.
perf_top() {  # perf_top cpu|mem
  local field=pcpu order=-r
  if [ "$1" = mem ]; then field=rss; order=-m; fi
  ps -Ao "$field=,comm=" "$order" 2>/dev/null | awk '
    { v = $1; sub(/^ *[^ ]+ /, ""); p = $0
      if (match(p, /[^\/]+\.app\/Contents\//)) { n = substr(p, RSTART, RLENGTH); sub(/\.app\/Contents\/$/, "", n) }
      else { n = p; sub(/.*\//, "", n) }
      if (n != "") t[n] += v }
    END { for (n in t) printf "%s\t%s\n", t[n], n }' | sort -t $'\t' -k1,1rn | head -n 5
}

plural() { if [ "$1" = 1 ]; then echo "1 $2"; else echo "$1 ${2}s"; fi; }

mark() { printf "  %-3s %s\n" "$1" "$2"; }

cmd_performance() {
  local v n level swap therm free total boot days battery cond cap cycles
  echo "  Using the most CPU right now (100% = one full core)"
  perf_top cpu | while IFS=$'\t' read -r v n; do printf "  %6.1f%%  %s\n" "$v" "$n"; done
  echo
  echo "  Using the most memory (approximate: memory shared between processes counts more than once)"
  perf_top mem | while IFS=$'\t' read -r v n; do printf "  %7s  %s\n" "$(echo "$v" | human)" "$n"; done
  echo
  echo "  System"
  level=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null)
  case "$level" in
    1) mark ok "Memory pressure is normal." ;;
    2) mark ! "Memory pressure is high. Quitting apps you aren't using will help." ;;
    4) mark ! "Memory pressure is critical. Quit apps or restart." ;;
    *) mark "?" "Couldn't read memory pressure." ;;
  esac
  swap=$(sysctl -n vm.swapusage 2>/dev/null | sed -n 's/.*used = \([0-9]*\)[.0-9]*M.*/\1/p')
  if [ -z "$swap" ]; then mark "?" "Couldn't read swap use."
  elif [ "$swap" -gt 1024 ]; then mark ! "Using $(echo $((swap * 1024)) | human) of swap: the Mac is short of memory."
  else mark ok "Little or no swap in use."
  fi
  therm=$(pmset -g therm 2>/dev/null)
  case "$therm" in
    "") mark "?" "Couldn't read the temperature status." ;;
    *"No thermal warning"*) mark ok "Not running hot." ;;
    *) mark ! "Running hot, so macOS may be slowing it down. Check for blocked vents or a busy app above." ;;
  esac
  free=$(df -Pk "$HOME" | awk 'NR == 2 { print $4 + 0 }')
  total=$(df -Pk "$HOME" | awk 'NR == 2 { print $2 + 1 }')
  if [ $((free * 10)) -lt "$total" ] || [ "$free" -lt 20971520 ]; then
    mark ! "Only $(echo "$free" | human) free. macOS slows down when the disk is nearly full: try Clean up junk."
  else mark ok "$(echo "$free" | human) of disk free."
  fi
  boot=$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\).*/\1/p')
  if [ -n "$boot" ]; then
    days=$(( ($(date +%s) - boot) / 86400 ))
    if [ "$days" -ge 14 ]; then mark ! "Last restarted $days days ago. A restart clears memory that builds up over time."
    else mark ok "Restarted $days days ago."
    fi
  fi
  battery=$(system_profiler SPPowerDataType 2>/dev/null)
  case "$battery" in *"Battery Information"*)
    cond=$(echo "$battery" | sed -n 's/^ *Condition: //p' | head -n 1)
    cap=$(echo "$battery" | sed -n 's/^ *Maximum Capacity: \([0-9]*\)%.*/\1/p' | head -n 1)
    cycles=$(echo "$battery" | sed -n 's/^ *Cycle Count: //p' | head -n 1)
    if [ "$cond" = Normal ] && [ "${cap:-100}" -ge 80 ]; then
      mark ok "Battery is normal: ${cap:-?}% of its original capacity, ${cycles:-?} cycles."
    else
      mark ! "Battery: ${cond:-unknown}, ${cap:-?}% of its original capacity, ${cycles:-?} cycles. Apple suggests service below 80%."
    fi ;;
  esac
  echo
  echo "  This is a snapshot of right now. Apps that start at login are in Startup items."
}

