#!/usr/bin/env bash
# macsweep — free up disk space on macOS from the command line.
# https://github.com/shannong57/macsweep  ·  MIT License
# Compatible with the stock macOS bash (3.2).
# shellcheck disable=SC2044,SC2001  # newline-only IFS and set -f make find loops safe
set -uf      # no globbing: every path below is literal
IFS=$'\n'    # split lists on newlines only, so paths may contain spaces

VERSION="0.4.0"
CATEGORIES=$'caches\nlogs\ntrash\nxcode\ndevcaches'
MENU=0       # 1 when running inside the menu, which is always interactive
ROOT="${MACSWEEP_ROOT:-}"   # prefix for system folders; lets the tests use a fake one

usage() {
  cat <<EOF
macsweep $VERSION — free up disk space on macOS

Usage:
  macsweep                            Open the menu
  macsweep scan                       Show reclaimable space per category
  macsweep clean [CATEGORY...]        Delete junk (all categories if none given)
      -n, --dry-run                   Show what would be deleted, delete nothing
      -y, --yes                       Don't ask for confirmation
  macsweep big [PATH] [--min MB]      List the 20 largest files (default: ~, 500 MB)
  macsweep uninstall APP [--yes]      Move an app and its leftovers to the Trash
  macsweep updates                    List outdated Homebrew, App Store and macOS items
  macsweep startup [enable|disable LABEL]  List startup items, or turn one on or off
  macsweep security                   Check security settings, app signatures and startup items
  macsweep help | version

Categories:
  caches     ~/Library/Caches
  logs       ~/Library/Logs
  trash      ~/.Trash
  xcode      Xcode DerivedData and simulator caches
  devcaches  npm, Gradle and ~/.cache (pip, etc.)

Cleaning only touches your own home folder and never needs sudo.
Some Maintenance tasks in the menu ask for your admin password.
EOF
}

# Directories whose *contents* get cleared for a category.
targets() {
  case "$1" in
    caches)    echo "$HOME/Library/Caches" ;;
    logs)      echo "$HOME/Library/Logs" ;;
    trash)     echo "$HOME/.Trash" ;;
    xcode)     echo "$HOME/Library/Developer/Xcode/DerivedData"
               echo "$HOME/Library/Developer/CoreSimulator/Caches" ;;
    devcaches) echo "$HOME/.npm/_cacache"
               echo "$HOME/.gradle/caches"
               echo "$HOME/.cache" ;;
    *) return 1 ;;
  esac
}

die() { echo "macsweep: $*" >&2; exit 1; }

confirm() {
  [ -t 0 ] || [ "$MENU" = 1 ] || die "not a terminal; pass --yes to confirm"
  printf "%s [y/N] " "$1"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) return 0 ;; esac
  echo "Cancelled."
  return 1
}

# KB on stdin -> "1.2G"
human() { awk '{ split("K M G T", u); s = $1; i = 1; while (s >= 1024 && i < 4) { s /= 1024; i++ } printf "%.1f%s\n", s, u[i] }'; }

size_kb() { du -sk "$1" 2>/dev/null | awk '{ s = $1 } END { print s + 0 }'; }

# Exists but macOS privacy protection won't let us list it.
blocked() { [ -d "$1" ] && ! ls "$1" >/dev/null 2>&1; }

category_blocked() {
  local d
  for d in $(targets "$1"); do blocked "$d" && return 0; done
  return 1
}

FDA_HINT="Grant your terminal Full Disk Access (System Settings > Privacy & Security) to include it."


# Refuse anything that isn't a real directory strictly inside the real $HOME.
safe_target() {
  local d="$1" real
  [ -d "$d" ] && [ ! -L "$d" ] || return 1
  real=$(cd "$d" 2>/dev/null && pwd -P) || return 1
  case "$real" in "$HOME_REAL"/?*) return 0 ;; esac
  return 1
}

category_kb() {
  local total=0 d
  for d in $(targets "$1"); do
    safe_target "$d" && total=$((total + $(size_kb "$d")))
  done
  echo "$total"
}

cmd_scan() {
  local cat kb grand=0 any_blocked=0
  for cat in $CATEGORIES; do
    kb=$(category_kb "$cat")
    grand=$((grand + kb))
    if category_blocked "$cat"; then
      printf "  %-10s %8s  (no access)\n" "$cat" "$(echo "$kb" | human)"; any_blocked=1
    else
      printf "  %-10s %8s\n" "$cat" "$(echo "$kb" | human)"
    fi
  done
  printf "  %-10s %8s\n" "TOTAL" "$(echo "$grand" | human)"
  echo
  [ "$any_blocked" = 1 ] && echo "Some folders are protected by macOS. $FDA_HINT"
  echo "Run 'macsweep clean' to reclaim it, or 'macsweep clean --dry-run' to preview."
}

cmd_clean() {
  local dry=0 yes=0 cats="" cat d before after freed=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -y|--yes)     yes=1 ;;
      -*) die "unknown option: $1" ;;
      *) targets "$1" >/dev/null || die "unknown category: $1 (try: caches logs trash xcode devcaches)"
         cats="$cats$1"$'\n' ;;
    esac
    shift
  done
  [ -n "$cats" ] || cats="$CATEGORIES"

  echo "Will clear:"
  for cat in $cats; do
    for d in $(targets "$cat"); do
      if blocked "$d"; then echo "  skipped   $d (no access). $FDA_HINT"; continue; fi
      safe_target "$d" || continue
      printf "  %8s  %s\n" "$(size_kb "$d" | human)" "$d"
    done
  done
  if [ "$dry" = 1 ]; then echo "(dry run — nothing deleted)"; return 0; fi

  if [ "$yes" != 1 ]; then
    confirm "Delete these contents?" || return 0
  fi

  for cat in $cats; do
    for d in $(targets "$cat"); do
      blocked "$d" && continue
      safe_target "$d" || continue
      before=$(size_kb "$d")
      # rm -rf removes symlinks themselves, never what they point to.
      find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
      after=$(size_kb "$d")
      freed=$((freed + before - after))
      [ "$after" -gt 64 ] && echo "  note: some items in $d are in use or protected; left in place"
    done
  done
  echo "Freed $(echo "$freed" | human)."
}

cmd_big() {
  local path="$HOME" min=500
  while [ $# -gt 0 ]; do
    case "$1" in
      --min) [ $# -ge 2 ] || die "--min needs a number"; min="$2"; shift ;;
      -*) die "unknown option: $1" ;;
      *) path="$1" ;;
    esac
    shift
  done
  case "$min" in ''|*[!0-9]*) die "--min must be a whole number of MB" ;; esac
  [ -d "$path" ] || die "not a directory: $path"
  # Filter on disk usage too: cloud-only files (Dropbox, iCloud) report a big size but use no disk.
  find "$path" -xdev -type f -size +$((min * 2048)) -exec du -k {} + 2>/dev/null \
    | awk -F'\t' -v min="$((min * 1024))" '$1 >= min' \
    | sort -rn | head -n 20 \
    | while IFS=$'\t' read -r kb f; do printf "  %8s  %s\n" "$(echo "$kb" | human)" "$f"; done
}

plist_get() { plutil -extract "$2" raw -o - "$1" 2>/dev/null; }

# "KB<tab>path" per app, biggest first. Apple's own apps are left out, except Xcode.
list_apps() {
  local a
  for a in $(find "$ROOT/Applications" "$HOME/Applications" -maxdepth 2 -name "*.app" -prune 2>/dev/null); do
    case "$(plist_get "$a/Contents/Info.plist" CFBundleIdentifier)" in
      com.apple.dt.Xcode) ;;
      com.apple.*) continue ;;
    esac
    printf "%s\t%s\n" "$(size_kb "$a")" "$a"
  done | sort -rn
}

# An app's files in ~/Library. Exact matches only, so another app's files are
# never picked up. The ID and name come from the app itself, so anything that
# could climb out of these folders is ignored.
leftovers() {
  local id="$1" name="$2" L="$HOME/Library" p
  case "$id" in ''|.*|*[!A-Za-z0-9._-]*) id="" ;; esac
  case "$name" in ''|.*|*/*) ;; *) [ -e "$L/Application Support/$name" ] && echo "$L/Application Support/$name" ;; esac
  [ -n "$id" ] || return 0
  for p in "$L/Application Support/$id" "$L/Caches/$id" "$L/Preferences/$id.plist" \
           "$L/Containers/$id" "$L/Saved Application State/$id.savedState" "$L/Logs/$id" \
           "$L/HTTPStorages/$id" "$L/WebKit/$id" "$L/LaunchAgents/$id.plist"; do
    if [ -e "$p" ] || [ -L "$p" ]; then echo "$p"; fi
  done
}

# Files outside your home folder. Listed for the user, never removed.
system_leftovers() {
  local id="$1" p
  case "$id" in ''|.*|*[!A-Za-z0-9._-]*) return 0 ;; esac
  for p in "$ROOT/Library/LaunchAgents/$id.plist" "$ROOT/Library/LaunchDaemons/$id.plist" \
           "$ROOT/Library/PrivilegedHelperTools/$id" "$ROOT/Library/Application Support/$id"; do
    if [ -e "$p" ]; then echo "$p"; fi
  done
}

# /usr/bin/trash arrived in macOS 15 and refuses root-owned apps, such as Xcode
# from the App Store. Finder covers both and can ask for an admin password.
to_trash() {
  if [ -x "$ROOT/usr/bin/trash" ]; then "$ROOT/usr/bin/trash" -s "$1" 2>/dev/null; fi
  if [ -e "$1" ] || [ -L "$1" ]; then
    osascript - "$1" >/dev/null 2>&1 <<'EOF'
on run argv
  tell application "Finder" to delete (POSIX file (item 1 of argv) as alias)
end run
EOF
  fi
  [ ! -e "$1" ] && [ ! -L "$1" ]
}

uninstall_app() {
  local app="$1" yes="${2:-0}" plist="$1/Contents/Info.plist" name id ver items sys p kb moved=0
  name=$(basename "$app" .app)
  id=$(plist_get "$plist" CFBundleIdentifier)
  ver=$(plist_get "$plist" CFBundleShortVersionString)
  # Matched in the shell: a grep here would see its own command line and always hit.
  case "$(ps -axo command=)" in
    *"$app/Contents/"*) echo "  $name is running. Quit it, then try again."; return 1 ;;
  esac
  items=$(leftovers "$id" "$name")
  sys=$(system_leftovers "$id")

  echo "$name $ver — will move to Trash:"
  for p in "$app" $items; do printf "  %8s  %s\n" "$(size_kb "$p" | human)" "$p"; done
  if [ -n "$sys" ]; then
    echo "System-wide files stay in place. To remove them yourself:"
    for p in $sys; do printf "  sudo rm -rf %q\n" "$p"; done
  fi
  if [ "$id" = com.apple.dt.Xcode ] && [ -d "$HOME/Library/Developer" ]; then
    echo "Stays in place: $HOME/Library/Developer ($(size_kb "$HOME/Library/Developer" | human))."
    echo "  It holds simulators and archived builds. For the part Xcode can rebuild: macsweep clean xcode"
  fi
  if [ "$yes" != 1 ]; then confirm "Proceed?" || return 0; fi

  kb=$(size_kb "$app")
  if ! to_trash "$app"; then
    echo "  Couldn't move $app to the Trash, so nothing was removed. It may need admin rights: try dragging it to the Trash in Finder."
    return 1
  fi
  moved=$kb
  for p in $items; do
    kb=$(size_kb "$p")
    if to_trash "$p"; then moved=$((moved + kb)); else echo "  Couldn't move $p; left in place."; fi
  done
  echo "Moved $(echo "$moved" | human) to Trash. (Recover with Finder > Put Back)"
}

cmd_uninstall() {
  local yes=0 name="" app
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      -*) die "unknown option: $1" ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "which app? Try: macsweep uninstall Slack"
  app=$(list_apps | awk -F'\t' -v n="/$name.app" '{
    p = tolower($2); s = tolower(n)
    if (substr(p, length(p) - length(s) + 1) == s) { print $2; exit }
  }')
  [ -n "$app" ] || die "no app named $name (of Apple's own apps, only Xcode can be removed)"
  uninstall_app "$app" "$yes"
}

cmd_updates() {
  local out
  echo "Homebrew:"
  if command -v brew >/dev/null; then
    out=$(brew outdated 2>/dev/null)
    if [ -n "$out" ]; then echo "$out" | sed 's/^/  /'; echo "  Update with: brew upgrade"; else echo "  Up to date."; fi
  else
    echo "  Not installed."
  fi
  echo "App Store:"
  if command -v mas >/dev/null; then
    out=$(mas outdated 2>/dev/null)
    if [ -n "$out" ]; then echo "$out" | sed 's/^/  /'; echo "  Update with: mas upgrade"; else echo "  Up to date."; fi
  else
    echo "  Skipped: needs the free mas tool (brew install mas)."
  fi
  echo "macOS:"
  out=$(softwareupdate -l 2>/dev/null | sed -n 's/^\* Label: //p')
  if [ -n "$out" ]; then
    echo "$out" | sed 's/^/  /'; echo "  Update in System Settings > General > Software Update."
  else
    echo "  Up to date."
  fi
  echo
  echo "Apps that update themselves, like Chrome or Zoom, aren't covered."
}

# Who signed a program. A leading ! marks one that deserves a look.
# ponytail: a script run through /bin/sh shows Apple as signer; read the arguments if that matters.
signer() {
  local p="$1" who
  [ -n "$p" ] || { echo "unknown program"; return; }
  case "$p" in /*) ;; *) p=$(command -v "$p") ;; esac
  [ -e "$p" ] || { echo "! program missing"; return; }
  who=$(codesign -dv --verbose=2 "$p" 2>&1 | sed -n 's/^Authority=//p' | head -n 1)
  [ -n "$who" ] || { echo "! not signed"; return; }
  codesign -v "$p" 2>/dev/null || { echo "! signature invalid"; return; }
  echo "$who" | sed 's/^Developer ID Application: //; s/ ([A-Z0-9]*)$//'
}

# "kind<tab>on|off<tab>label<tab>signer<tab>plist" per launch agent and daemon.
list_startup() {
  local dir kind plist label prog state off_gui off_sys off
  off_gui=$(launchctl print-disabled "gui/$(id -u)" 2>/dev/null | awk -F'"' '/=> (disabled|true)/ { print $2 }')
  off_sys=$(launchctl print-disabled system 2>/dev/null | awk -F'"' '/=> (disabled|true)/ { print $2 }')
  for dir in "$HOME/Library/LaunchAgents" "$ROOT/Library/LaunchAgents" "$ROOT/Library/LaunchDaemons"; do
    case "$dir" in *Daemons) kind=daemon; off="$off_sys" ;; *) kind=agent; off="$off_gui" ;; esac
    for plist in $(find "$dir" -maxdepth 1 -name "*.plist" 2>/dev/null | sort); do
      label=$(plist_get "$plist" Label); label="${label:-$(basename "$plist" .plist)}"
      prog=$(plist_get "$plist" Program || plist_get "$plist" ProgramArguments.0)
      state=on
      if echo "$off" | grep -qxF -- "$label"; then state=off; fi
      printf "%s\t%s\t%s\t%s\t%s\n" "$kind" "$state" "$label" "$(signer "$prog")" "$plist"
    done
  done
}

print_startup() {
  local i=0 kind state label who plist
  printf "  %3s  %-4s %-50s %s\n" "#" "" "Item" "Signed by"
  echo "$1" | while IFS=$'\t' read -r kind state label who plist; do
    i=$((i + 1))
    printf "  %3s  %-4s %-50.50s %s\n" "$i" "$state" "$label" "$who"
  done
  echo
  echo "  ! means worth a look: the program is unsigned, damaged or gone."
  # ponytail: login items aren't listed; asking System Events for them takes about 100 seconds.
  echo "  Login items are in System Settings > General > Login Items."
}

# Turn one item on or off. Daemons belong to the whole Mac, so those only get the command.
startup_set() {
  local want="$1" kind="$2" label="$3" plist="$4" verb=disable domain
  [ "$want" = on ] && verb=enable
  case "$label" in *[!A-Za-z0-9._-]*)
    echo "  This item has an unusual name, so macsweep won't touch it. Check it by hand: $plist"
    return 1 ;;
  esac
  if [ "$kind" = daemon ]; then
    echo "  This runs for the whole Mac. To change it yourself:"
    echo "  sudo launchctl $verb system/$label"
    return 0
  fi
  domain="gui/$(id -u)"
  launchctl "$verb" "$domain/$label" || { echo "  Couldn't change $label."; return 1; }
  if [ "$want" = on ]; then
    launchctl bootstrap "$domain" "$plist" 2>/dev/null
  else
    launchctl bootout "$domain/$label" 2>/dev/null
  fi
  echo "  $label is now $want."
}

cmd_startup() {
  local rows row kind state label who plist want
  case "${1:-}" in
    "") rows=$(list_startup); print_startup "$rows"; return ;;
    enable) want=on ;;
    disable) want=off ;;
    *) die "unknown startup action: $1 (try: enable, disable)" ;;
  esac
  [ $# -ge 2 ] || die "which item? Run 'macsweep startup' to list them"
  row=$(list_startup | awk -F'\t' -v l="$2" '$3 == l { print; exit }')
  [ -n "$row" ] || die "no startup item named $2"
  IFS=$'\t' read -r kind state label who plist <<EOF
$row
EOF
  startup_set "$want" "$kind" "$label" "$plist"
}

# One line per setting: ok, ! for something to fix, ? if macOS wouldn't say.
setting() {  # setting NAME OUTPUT TEXT-WHEN-ON HOW-TO-FIX
  case "$2" in
    "") printf "  ?   %s: couldn't check\n" "$1" ;;
    *"$3"*) printf "  ok  %s is on\n" "$1" ;;
    *) printf "  !   %s is off. %s\n" "$1" "$4" ;;
  esac
}

flagged_startup() { list_startup | awk -F'\t' 'index($4, "!") == 1'; }

# Apple's apps are left out by list_apps. Xcode is checked with the rest.
flagged_apps() {
  local kb a who
  list_apps | while IFS=$'\t' read -r kb a; do
    who=$(signer "$a")
    case "$who" in !*) printf "  %-20s %s\n" "$who" "$a" ;; esac
  done
}

# $1 is the rows from flagged_startup, numbered so the menu can act on them.
print_security() {
  local apps profiles i=0 kind state label who plist
  echo "  Mac settings"
  setting "Gatekeeper" "$(spctl --status 2>/dev/null)" "assessments enabled" "Turn it on in System Settings > Privacy & Security."
  setting "System Integrity Protection" "$(csrutil status 2>/dev/null)" "status: enabled" "Turning it back on needs Recovery mode: csrutil enable"
  setting "FileVault" "$(fdesetup status 2>/dev/null)" "FileVault is On" "Turn it on in System Settings > Privacy & Security."
  setting "Firewall" "$("$ROOT/usr/libexec/ApplicationFirewall/socketfilterfw" --getglobalstate 2>/dev/null)" "is enabled" "Turn it on in System Settings > Network > Firewall."
  echo
  echo "  Configuration profiles (your account only)"
  profiles=$(profiles list 2>/dev/null)
  case "$profiles" in
    "") echo "  ?   Couldn't check." ;;
    *"no configuration profiles"*) echo "  ok  None installed." ;;
    *) echo "  !   Profiles are installed. Normal on a work Mac; otherwise check System Settings > General > Device Management." ;;
  esac
  echo
  echo "  Apps"
  apps=$(flagged_apps)
  if [ -n "$apps" ]; then echo "$apps"; else echo "  ok  All signed."; fi
  echo
  echo "  Startup items"
  if [ -z "$1" ]; then
    echo "  ok  Nothing flagged."
  else
    echo "$1" | while IFS=$'\t' read -r kind state label who plist; do
      i=$((i + 1))
      printf "  %3s  %-20s %s\n" "$i" "$who" "$label"
    done
  fi
  echo
  echo "  ! means worth a look, not that it's harmful. Plenty of good apps are unsigned or fail this check."
  echo "  This is not a malware scan: it checks settings and signatures only. macOS runs its own"
  echo "  malware protection. If you're worried, use a dedicated scanner such as Malwarebytes."
}

cmd_security() {
  echo "  Checking..."
  print_security "$(flagged_startup)"
}

# Stops an item starting and bins its plist. The program it ran is left for the user to judge.
remove_startup_item() {
  local kind="$1" label="$2" plist="$3" prog
  prog=$(plist_get "$plist" Program || plist_get "$plist" ProgramArguments.0)
  startup_set off "$kind" "$label" "$plist" || return 1
  case "$plist" in
    "$HOME"/*)
      if ! to_trash "$plist"; then echo "  Couldn't move $plist to the Trash."; return 1; fi
      echo "  Moved $plist to the Trash. (Recover with Finder > Put Back)" ;;
    *) echo "  To remove the file too:"; printf "  sudo rm %q\n" "$plist" ;;
  esac
  if [ -e "$prog" ]; then echo "  The program it ran is still at $prog. Check it before deleting it."; fi
}

# Chromium browsers: name, folder in ~/Library/Application Support, app name.
BROWSERS=$'Chrome\tGoogle/Chrome\tGoogle Chrome
Edge\tMicrosoft Edge\tMicrosoft Edge
Brave\tBraveSoftware/Brave-Browser\tBrave Browser
Arc\tArc/User Data\tArc
Vivaldi\tVivaldi\tVivaldi'
KEEP_FILE="$HOME/Library/Application Support/macsweep/keep-sites"

# "browser<tab>profile<tab>app<tab>table<tab>column<tab>file" per cookie database.
cookie_dbs() {
  local AS="$HOME/Library/Application Support" name dir app db p label
  echo "$BROWSERS" | while IFS=$'\t' read -r name dir app; do
    for db in $(find "$AS/$dir" -maxdepth 3 -type f -name Cookies 2>/dev/null | sort); do
      p=${db#"$AS/$dir/"}; p=${p%%/*}
      label=$(plist_get "$AS/$dir/Local State" "profile.info_cache.$p.name")
      printf "%s\t%s\t%s\tcookies\thost_key\t%s\n" "$name" "${label:-$p}" "$app" "$db"
    done
  done
  for db in $(find "$AS/Firefox/Profiles" -maxdepth 2 -type f -name cookies.sqlite 2>/dev/null | sort); do
    p=$(basename "$(dirname "$db")")
    printf "Firefox\t%s\tFirefox\tmoz_cookies\thost\t%s\n" "${p#*.}" "$db"
  done
}

# Read-only and immutable, so it works while the browser holds its lock.
sql_read() {
  sqlite3 -readonly "file:$(printf %s "$1" | sed 's/%/%25/g; s/?/%3f/g; s/#/%23/g')?immutable=1" "$2" 2>/dev/null
}

# "count<tab>site" per site, most cookies first. A site is the last two parts of
# the host, or three for names like example.co.uk.
# ponytail: no public suffix list, so a few country domains group too broadly or narrowly.
cookie_sites() {  # cookie_sites FILE TABLE COLUMN
  sql_read "$1" "SELECT $3 FROM $2" | awk -F. '
    { sub(/^\./, ""); n = NF; if ($0 == "") next
      if (n >= 3 && length($n) == 2 && $(n-1) ~ /^(co|com|net|org|gov|ac|edu)$/) s = $(n-2) "." $(n-1) "." $n
      else if (n >= 2) s = $(n-1) "." $n
      else s = $0
      c[s]++ }
    END { for (s in c) printf "%d\t%s\n", c[s], s }' | sort -t $'\t' -k1,1rn -k2,2
}

# Removes every cookie for the given sites and their subdomains. Prints how many went.
delete_cookies() {  # delete_cookies FILE TABLE COLUMN SITES
  local where="" s
  for s in $4; do
    case "$s" in ''|.*|*[!A-Za-z0-9.-]*) continue ;; esac
    where="$where OR $3 = '$s' OR $3 = '.$s' OR $3 LIKE '%.$s'"
  done
  [ -n "$where" ] || { echo 0; return 0; }
  sqlite3 "$1" "DELETE FROM $2 WHERE 0$where; SELECT changes();" 2>/dev/null
}

kept_sites() { cat "$KEEP_FILE" 2>/dev/null || true; }
without_kept() { awk -v k="$(kept_sites)" 'BEGIN { n = split(k, a, "\n"); for (i = 1; i <= n; i++) K[a[i]] } !($0 in K)'; }

keep_sites() {  # keep_sites add|remove SITES
  mkdir -p "$(dirname "$KEEP_FILE")" || return 1
  if [ "$1" = add ]; then
    printf "%s\n%s\n" "$(kept_sites)" "$2" | sed '/^$/d' | sort -u > "$KEEP_FILE.new"
  else
    kept_sites | awk -v k="$2" 'BEGIN { n = split(k, a, "\n"); for (i = 1; i <= n; i++) K[a[i]] } !($0 in K)' > "$KEEP_FILE.new"
  fi
  mv "$KEEP_FILE.new" "$KEEP_FILE"
}

browser_running() { case "$(ps -axo command=)" in *"/$1.app/Contents/MacOS/"*) return 0 ;; esac; return 1; }

flush_dns() { sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder; }

rebuild_open_with() {
  "$ROOT/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister" \
    -r -f -apps local,system,user
}

remove_snapshots() {
  local dates="$1" d ok=0
  for d in $dates; do sudo tmutil deletelocalsnapshots "$d" || ok=1; done
  return "$ok"
}

task_result() { if [ "$1" = 0 ]; then echo "  Done."; else echo "  That didn't work."; fi; }

# Prompt into $reply. q quits from any menu, and so does end of input.
ask() {
  printf "%s" "$1"
  read -r reply || { echo; exit 0; }
  case "$reply" in q|Q) exit 0 ;; esac
}

cat_label() {
  case "$1" in
    caches) echo "Caches" ;;
    logs)   echo "Logs" ;;
    trash)  echo "Trash" ;;
    xcode)  echo "Xcode" ;;
    devcaches) echo "Dev caches" ;;
  esac
}

# "1 3" -> those category names, one per line. Fails on anything else, and on
# an empty selection: cmd_clean treats no categories as all of them.
# The lines of LIST picked by INPUT, a set of 1-based numbers.
pick() {  # pick LIST INPUT
  local n c out=""
  for n in $(echo "$2" | tr -s " ," "\n"); do
    case "$n" in *[!0-9]*) return 1 ;; esac
    c=$(echo "$1" | sed -n "${n}p" 2>/dev/null)
    [ -n "$c" ] || return 1
    case $'\n'"$out" in *$'\n'"$c"$'\n'*) ;; *) out="$out$c"$'\n' ;; esac
  done
  [ -n "$out" ] || return 1
  printf "%s" "$out"
}

menu_clean() {
  local cat i picked
  while :; do
    echo; echo "  Clean up junk — scanning..."
    i=0
    for cat in $CATEGORIES; do
      i=$((i + 1))
      if category_blocked "$cat"; then
        printf "  %s  %-12s (no access, needs Full Disk Access)\n" "$i" "$(cat_label "$cat")"
      else
        printf "  %s  %-12s %8s\n" "$i" "$(cat_label "$cat")" "$(category_kb "$cat" | human)"
      fi
    done
    echo "  a  All     b  Back"
    echo
    ask "Clean which? (numbers, a for all, b to go back): "
    case "$reply" in
      b|B) return ;;
      a|A) picked="$CATEGORIES" ;;
      *) picked=$(pick "$CATEGORIES" "$reply") || { echo "  Not a valid choice."; continue; } ;;
    esac
    # shellcheck disable=SC2086  # one category per line, split on IFS
    cmd_clean $picked
  done
}

menu_big() {
  local path min out
  echo
  ask "Folder to search (Enter for your home folder, b to go back): "
  case "$reply" in b|B) return ;; esac
  path="${reply:-$HOME}"
  path="${path/#\~/$HOME}"
  [ -d "$path" ] || { echo "  Not a folder: $path"; return; }
  ask "Smallest size in MB (Enter for 500, b to go back): "
  case "$reply" in b|B) return ;; esac
  min="${reply:-500}"
  case "$min" in *[!0-9]*) echo "  Size must be a whole number of MB."; return ;; esac
  echo "  Searching..."
  out=$(cmd_big "$path" --min "$min")
  echo "${out:-  Nothing that large.}"
  echo
  ask "Press Enter to go back: "
}

menu_uninstall() {
  local apps="" scan=1 i kb app
  while :; do
    if [ "$scan" = 1 ]; then echo; echo "  Measuring apps..."; apps=$(list_apps); fi
    [ -n "$apps" ] || { echo "  No apps found."; return; }
    printf "  %3s  %-30.30s %-16.16s %8s\n" "#" "App" "Version" "Size"
    i=0
    echo "$apps" | while IFS=$'\t' read -r kb app; do
      i=$((i + 1))
      printf "  %3s  %-30.30s %-16.16s %8s\n" "$i" "$(basename "$app" .app)" \
        "$(plist_get "$app/Contents/Info.plist" CFBundleShortVersionString)" "$(echo "$kb" | human)"
    done
    echo
    ask "Uninstall which? (number, b to go back): "
    scan=0
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    app=$(echo "$apps" | sed -n "${reply}p" 2>/dev/null | cut -f2-)
    [ -n "$app" ] || { echo "  Not a valid choice."; continue; }
    uninstall_app "$app"
    scan=1
  done
}

menu_apps() {
  while :; do
    echo
    echo "  Applications"
    echo "  1  Uninstall an app"
    echo "  2  Check for updates"
    echo "  b  Back"
    echo
    ask "Choose: "
    case "$reply" in
      1) menu_uninstall ;;
      2) echo "  Checking, this can take a minute..."; cmd_updates; echo; ask "Press Enter to go back: " ;;
      b|B) return ;;
      *) echo "  Not a valid choice." ;;
    esac
  done
}

menu_startup() {
  local rows="" scan=1 row kind state label who plist want
  while :; do
    if [ "$scan" = 1 ]; then echo; echo "  Checking startup items..."; rows=$(list_startup); fi
    [ -n "$rows" ] || { echo "  No startup items found."; return; }
    print_startup "$rows"
    echo
    ask "Turn which on or off? (number, b to go back): "
    scan=0
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    row=$(echo "$rows" | sed -n "${reply}p" 2>/dev/null)
    [ -n "$row" ] || { echo "  Not a valid choice."; continue; }
    IFS=$'\t' read -r kind state label who plist <<EOF
$row
EOF
    if [ "$state" = on ]; then want=off; else want=on; fi
    case "$kind:$label" in
      daemon:*|*[!A-Za-z0-9._:-]*) ;;
      *) confirm "Turn $label $want?" || continue ;;
    esac
    startup_set "$want" "$kind" "$label" "$plist"
    scan=1
  done
}

menu_maintenance() {
  local dates count
  while :; do
    echo
    echo "  Maintenance"
    echo "  1  Flush the DNS cache                  (admin password)"
    echo "  2  Rebuild the Spotlight search index   (admin password)"
    echo "  3  Remove Time Machine local snapshots  (admin password)"
    echo "  4  Fix duplicate \"Open With\" entries"
    echo "  5  Check the startup disk for errors"
    echo "  b  Back"
    echo
    ask "Run which? (number, b to go back): "
    case "$reply" in
      b|B) return ;;
      1) if confirm "Flush the DNS cache?"; then flush_dns; task_result $?; fi ;;
      2) echo "  Search results will be incomplete and the Mac may run warm until indexing finishes."
         if confirm "Rebuild the Spotlight index?"; then sudo mdutil -E /; task_result $?; fi ;;
      3) dates=$(tmutil listlocalsnapshotdates / 2>/dev/null | sed -n '/^[0-9]/p')
         if [ -z "$dates" ]; then echo "  No local snapshots."; continue; fi
         count=$(echo "$dates" | wc -l | tr -d ' ')
         echo "  $count local snapshots, the oldest from $(echo "$dates" | head -n 1)."
         echo "  This can't be undone. You lose these restore points until Time Machine makes new ones."
         if confirm "Remove all of them?"; then remove_snapshots "$dates"; task_result $?; fi ;;
      4) if confirm "Rebuild the Open With list?"; then rebuild_open_with; task_result $?; fi ;;
      5) echo "  The Mac may pause briefly while the disk is checked."
         if confirm "Check the startup disk?"; then diskutil verifyVolume /; task_result $?; fi ;;
      *) echo "  Not a valid choice." ;;
    esac
  done
}

menu_security() {
  local rows="" scan=1 row kind state label who plist
  while :; do
    if [ "$scan" = 1 ]; then echo; echo "  Checking..."; rows=$(flagged_startup); fi
    print_security "$rows"
    echo
    if [ -z "$rows" ]; then ask "Press Return to go back: "; return; fi
    ask "Remove which startup item? (number, b to go back): "
    scan=0
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    row=$(echo "$rows" | sed -n "${reply}p" 2>/dev/null)
    [ -n "$row" ] || { echo "  Not a valid choice."; continue; }
    IFS=$'\t' read -r kind state label who plist <<EOF
$row
EOF
    if [ "$kind" != daemon ]; then confirm "Turn off $label and remove it?" || continue; fi
    remove_startup_item "$kind" "$label" "$plist"
    scan=1
  done
}

menu_cookies() {  # menu_cookies ROW-FROM-cookie_dbs
  local name label app table col db sites list picked n total i=0 c s mark
  IFS=$'\t' read -r name label app table col db <<EOF
$1
EOF
  if browser_running "$app"; then echo "  Quit $app first. macsweep won't change cookies while it's open."; return; fi
  if ! sql_read "$db" "SELECT $col FROM $table LIMIT 1" >/dev/null; then
    echo "  This version of $name stores cookies in a way macsweep doesn't recognise, so nothing was changed."
    return
  fi
  while :; do
    sites=$(cookie_sites "$db" "$table" "$col")
    [ -n "$sites" ] || { echo "  No cookies in $name ($label)."; return; }
    list=$(echo "$sites" | cut -f2)
    echo
    echo "  $name ($label): cookies by site"
    i=0
    echo "$sites" | while IFS=$'\t' read -r c s; do
      i=$((i + 1)); mark=""
      if kept_sites | grep -qxF -- "$s"; then mark="kept"; fi
      printf "  %4s  %-40.40s %5s  %s\n" "$i" "$s" "$c" "$mark"
    done
    echo
    echo "  numbers  remove those sites      a  remove all except kept"
    echo "  k 1 2    always keep sites       u 1 2  stop keeping sites      b  back"
    ask "Choose: "
    case "$reply" in
      b|B|"") return ;;
      a|A) picked="$list" ;;
      [kK]\ *|[uU]\ *)
        picked=$(pick "$list" "${reply#??}") || { echo "  Not a valid choice."; continue; }
        case "$reply" in [kK]*) keep_sites add "$picked" ;; *) keep_sites remove "$picked" ;; esac
        continue ;;
      *) picked=$(pick "$list" "$reply") || { echo "  Not a valid choice."; continue; } ;;
    esac
    picked=$(echo "$picked" | without_kept)
    [ -n "$picked" ] || { echo "  Nothing to remove: those sites are kept."; continue; }
    n=$(echo "$picked" | wc -l | tr -d ' ')
    total=$(echo "$sites" | awk -F'\t' -v p="$picked" 'BEGIN { split(p, a, "\n"); for (i in a) P[a[i]] } $2 in P { t += $1 } END { print t + 0 }')
    echo "  Remove $total cookies from $n sites:"
    echo "$picked" | head -n 10 | sed 's/^/    /'
    [ "$n" -gt 10 ] && echo "    ...and $((n - 10)) more"
    echo "  You'll be signed out of these sites. This can't be undone."
    confirm "Remove them?" || continue
    if browser_running "$app"; then echo "  $app is open now, so nothing was removed."; continue; fi
    if total=$(delete_cookies "$db" "$table" "$col" "$picked") && [ -n "$total" ]; then
      echo "  Removed $total cookies."
    else
      echo "  Couldn't change the cookie file, so nothing was removed."
    fi
  done
}

menu_browser() {
  local dbs row i name label app table col db c
  while :; do
    dbs=$(cookie_dbs)
    echo
    echo "  Browser cleanup: cookies"
    if [ -z "$dbs" ]; then
      echo "  No Chrome, Edge, Brave, Arc, Vivaldi or Firefox profiles found."
    else
      i=0
      echo "$dbs" | while IFS=$'\t' read -r name label app table col db; do
        i=$((i + 1))
        c=$(sql_read "$db" "SELECT count(*) FROM $table") || c="?"
        printf "  %3s  %-8s %-30.30s %6s cookies\n" "$i" "$name" "$label" "$c"
      done
    fi
    echo
    echo "  Safari: use Safari > Settings > Privacy > Manage Website Data."
    echo "  Browser caches are part of Clean up junk. Passwords, history and bookmarks are never touched."
    echo
    ask "Which profile? (number, b to go back): "
    case "$reply" in
      b|B|"") return ;;
      *[!0-9]*) echo "  Not a valid choice."; continue ;;
    esac
    row=$(echo "$dbs" | sed -n "${reply}p" 2>/dev/null)
    [ -n "$row" ] || { echo "  Not a valid choice."; continue; }
    menu_cookies "$row"
  done
}

menu_main() {
  local disk
  while :; do
    disk=$(df -Pk "$HOME" | awk 'NR == 2 { print $4; print $2 }' | human | paste -sd " " - | sed "s/ / free of /")
    echo
    printf "  macsweep — Mac cleanup            Disk: %s\n\n" "$disk"
    echo "  1  Clean up junk          (caches, logs, Trash, Xcode, dev caches)"
    echo "  2  Find large files"
    echo "  3  Applications           (uninstall, updates)"
    echo "  4  Startup items"
    echo "  5  Maintenance"
    echo "  6  Security check"
    echo "  7  Browser cleanup        (cookies, site by site)"
    echo "  q  Quit"
    echo
    ask "Choose: "
    case "$reply" in
      1) menu_clean ;;
      2) menu_big ;;
      3) menu_apps ;;
      4) menu_startup ;;
      5) menu_maintenance ;;
      6) menu_security ;;
      7) menu_browser ;;
      *) echo "  Not a valid choice." ;;
    esac
  done
}

[ -n "${HOME:-}" ] && [ "$HOME" != "/" ] || die "HOME is not set"
HOME_REAL=$(cd "$HOME" && pwd -P) || die "can't resolve HOME"

# Bare macsweep opens the menu at a terminal and scans when scripted.
if [ $# -eq 0 ] && [ -t 0 ]; then cmd=menu; else cmd="${1:-scan}"; fi
[ $# -gt 0 ] && shift
case "$cmd" in
  menu)    MENU=1; menu_main ;;
  scan)    cmd_scan ;;
  clean)   cmd_clean "$@" ;;
  big)     cmd_big "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  updates) cmd_updates ;;
  startup) cmd_startup "$@" ;;
  security) cmd_security ;;
  version|--version) echo "macsweep $VERSION" ;;
  help|-h|--help)    usage ;;
  *) usage >&2; exit 1 ;;
esac
